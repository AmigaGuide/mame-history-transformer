{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:exotica:schema:gh_ini_classifications:1.1.0",
  "title": "GH INI Classifications",
  "description": "Classification metadata derived from INI files, keyed by MAME machine name.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^[a-z0-9_]+$": {
      "type": "object",
      "additionalProperties": false,
      "required": ["game_status", "category", "type"],
      "properties": {
        "game_status": {
          "type": "string",
          "enum": ["game", "no_game", "unknown"]
        },
        "category": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "type": { "type": "string", "minLength": 1 }
      }
    }
  }
}
